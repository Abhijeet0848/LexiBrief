# ==========================================
# LexiBrief Environment Configuration Template
# ==========================================

# Option 1: Full Connection String (Recommended for MongoDB Atlas Cloud)
MONGODB_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER-HOST>/lexibrief_db?retryWrites=true&w=majority

# Option 2: Individual MongoDB Credentials
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_CLUSTER=cluster0.mongodb.net
MONGODB_DB=lexibrief_db

# Optional Security Admin Secret Key (Protects /train pipeline trigger)
ADMIN_SECRET_KEY=your_secure_admin_key_here

# Optional YouTube Session Cookies (Bypasses Vercel/Cloud IP bot rate limits)
# Paste contents of Netscape cookies.txt exported via 'Get cookies.txt LOCALLY' extension
# YOUTUBE_COOKIES_TXT="# Netscape HTTP Cookie File\n..."
# YOUTUBE_COOKIE_PATH="cookies.txt"
